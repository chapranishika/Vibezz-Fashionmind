# ── AI Stylist LLM ──────────────────────────────────────────────────────────
# Preferred: OpenRouter (one key -> many models incl. free ones).
#   key:   https://openrouter.ai/keys
#   model: any id from https://openrouter.ai/models (":free" = no cost)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
# Fallback if OpenRouter is unset:
GEMINI_API_KEY=your_gemini_api_key_here
ENVIRONMENT=development

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://cxfsiotzfshrjdrctmge.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here   # get from Supabase dashboard > Settings > API

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Demo login credentials (bypass DB connection)
DEMO_EMAIL=demo@vibezz.com
DEMO_PASSWORD=vibezz-demo-pass
DEMO_CUSTOMER_ID=00009d946eec3ea54add5ba56d5210ea898def4b46c68570cf0096d962cacc75

# ── Experimental trend-aggregator (not part of the core recommender) ─────────
# Only needed if you use the /catalog/* routes. Everything degrades to a cache.
PINTEREST_ACCESS_TOKEN=
PINTEREST_ALLOW_UNOFFICIAL=
SERPAPI_KEY=
