GEMINI_API_KEY=your_gemini_api_key_here
ENVIRONMENT=development

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://cxfsiotzfshrjdrctmge.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here   # get from Supabase dashboard > Settings > API

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Demo login credentials (bypass DB connection)
DEMO_EMAIL=demo@vibezz.com
DEMO_PASSWORD=vibezz-demo-pass
DEMO_CUSTOMER_ID=00009d946eec3ea54add5ba56d5210ea898def4b46c68570cf0096d962cacc75

# ── Trend + aggregator sources (all optional — everything degrades to cached / curated) ──
# Pinterest Trends API v5 (OAuth token with trends scope). Without it, the app
# uses a shipped cache seed (data/features/pinterest_trends_cache.json).
PINTEREST_ACCESS_TOKEN=
# Opt in to the undocumented trends.pinterest.com endpoint (no auth, fragile,
# against Pinterest ToS). Leave unset unless you accept that.
PINTEREST_ALLOW_UNOFFICIAL=
# SerpApi key for live Google Shopping (gl=in) product results. Without it the
# aggregator serves the curated seed (data/catalog/trend_products.json) + the
# trained H&M catalogue only.
SERPAPI_KEY=
